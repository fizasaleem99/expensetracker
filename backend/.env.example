PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=ExpenseTracker
# Optional: pick a database name (leave out to keep using Atlas's default one)
# DB_NAME=expense-tracker
JWT_SECRET=replace_with_a_long_random_string
NODE_ENV=development
# Frontend origin(s), comma separated, no trailing slash
CLIENT_URL=http://localhost:5173
